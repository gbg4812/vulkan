// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "Run Renderdoc",
    "command": "qrenderdoc",
    "args": ["./tools/capture-app.cap"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "Compile Debug",
    "command": "cmake --build build-debug --parallel",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },

  {
    "label": "Pandoc compile",
    "command": "echo $ZED_FILE | entr pandoc $ZED_FILE -o $ZED_FILE.pdf --from markdown --template eisvogel --filter pandoc-latex-environment",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
]
