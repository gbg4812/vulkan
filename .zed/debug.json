// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug app",
    "build": {
      "command": "cmake",
      "args": ["--build", "--preset", "Debug Rebuild"],
      "cwd": "$ZED_WORKTREE_ROOT",
      "use_new_terminal": true,
      "shell": {
        "program": "zsh",
      },
    },
    "program": "$ZED_WORKTREE_ROOT/build-debug/app",
    "args": ["./data/models/EasyModels/scene.obj"],
    "cwd": "$ZED_WORKTREE_ROOT/tests/",
    "request": "launch",
    "initCommands": [
      "command script import ./tools/Hive_print_provider.py",
      "type synth add --regex --python-class Hive_print_provider.HiveChildProvider \"^Hive<.*>$\"",
    ],
    "adapter": "CodeLLDB",
  },
]
