struct Light {
    vec3 color;
    vec3 direction;
    vec3 position;
    mat4 proj;
    float intensity;
    int shadow_map;
};

layout(std430, set = 0, binding = 2) readonly buffer LightBlock {
    Light lights[];
} lightData;

layout(set = 2, binding = 0) uniform texture2D _shadow_map;

vec2 rotate2D(vec2 vec, float angle) {
    mat2 m = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));

    return vec * m;
}

